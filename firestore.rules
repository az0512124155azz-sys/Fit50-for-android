rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "az0512124155azz@gmail.com";
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if signedIn() && request.auth.uid == userId;

      match /{document=**} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /passwordResetRequests/{requestId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          "email", "source", "status", "createdAt", "error"
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.source in ["app", "admin"]
        && request.resource.data.status in [
          "firebase_accepted", "send_error", "admin_accepted"
        ]
        && request.resource.data.error is string
        && request.resource.data.createdAt == request.time;

      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
